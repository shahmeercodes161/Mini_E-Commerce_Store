{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://mini-e-commerce-store-xqv2.vercel.app/api"
    },
    {
      "source": "/api/:match*",
      "destination": "https://mini-e-commerce-store-xqv2.vercel.app/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://mini-e-commerce-store-xqv2.vercel.app/uploads/:match*"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}

